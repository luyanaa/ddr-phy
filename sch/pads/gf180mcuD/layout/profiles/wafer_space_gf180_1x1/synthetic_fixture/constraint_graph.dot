digraph composite_constraints {
  rankdir=LR;
  label="composite constraint graph (one param drives several classes)";
  labelloc=t;
  node [shape=box];
  "W_N_TOTAL" [shape=ellipse];
  "W_N_OUT" -> "W_N_TOTAL";
  "NF_N_OUT" -> "W_N_TOTAL";
  "M_DEVICE" -> "W_N_TOTAL";
  "W_P_TOTAL" [shape=ellipse];
  "W_P_OUT" -> "W_P_TOTAL";
  "NF_P_OUT" -> "W_P_TOTAL";
  "M_DEVICE" -> "W_P_TOTAL";
  "DRIVER_WIDTH" [shape=ellipse];
  "W_N_TOTAL" -> "DRIVER_WIDTH";
  "W_P_TOTAL" -> "DRIVER_WIDTH";
  "ESD_UP_SIDE" [shape=ellipse];
  "ESD_AREA_UP" -> "ESD_UP_SIDE";
  "ESD_DN_SIDE" [shape=ellipse];
  "ESD_AREA_DN" -> "ESD_DN_SIDE";
  "RAIL_WIDTH_2X" [shape=ellipse];
  "RAIL_WIDTH" -> "RAIL_WIDTH_2X";
  "GUARD_SPACING_2X" [shape=ellipse];
  "GUARD_RING_SPACING" -> "GUARD_SPACING_2X";
  "GUARD_WIDTH_2X" [shape=ellipse];
  "GUARD_RING_WIDTH" -> "GUARD_WIDTH_2X";
  "CELL_WIDTH" [shape=ellipse];
  "DRIVER_WIDTH" -> "CELL_WIDTH";
  "GUARD_SPACING_2X" -> "CELL_WIDTH";
  "RAIL_WIDTH_2X" -> "CELL_WIDTH";
  "CELL_HEIGHT" [shape=ellipse];
  "L_N_OUT" -> "CELL_HEIGHT";
  "L_P_OUT" -> "CELL_HEIGHT";
  "GUARD_WIDTH_2X" -> "CELL_HEIGHT";
  "ESD_UP_SIDE" -> "CELL_HEIGHT";
  "ESD_DN_SIDE" -> "CELL_HEIGHT";
  "RAIL_WIDTH_FROM_EM" [shape=ellipse];
  "IO_CURRENT" -> "RAIL_WIDTH_FROM_EM";
  "METAL_JMAX" -> "RAIL_WIDTH_FROM_EM";
  "cell_width_fits_pitch" [shape=diamond,style=filled,fillcolor=lightgrey];
  "GUARD_RING_SPACING" -> "cell_width_fits_pitch" [style=dotted];
  "M_DEVICE" -> "cell_width_fits_pitch" [style=dotted];
  "NF_N_OUT" -> "cell_width_fits_pitch" [style=dotted];
  "NF_P_OUT" -> "cell_width_fits_pitch" [style=dotted];
  "PAD_PITCH" -> "cell_width_fits_pitch" [style=dotted];
  "RAIL_WIDTH" -> "cell_width_fits_pitch" [style=dotted];
  "cell_height_fits_open" [shape=diamond,style=filled,fillcolor=lightgrey];
  "ESD_AREA_DN" -> "cell_height_fits_open" [style=dotted];
  "ESD_AREA_UP" -> "cell_height_fits_open" [style=dotted];
  "GUARD_RING_WIDTH" -> "cell_height_fits_open" [style=dotted];
  "L_N_OUT" -> "cell_height_fits_open" [style=dotted];
  "L_P_OUT" -> "cell_height_fits_open" [style=dotted];
  "PAD_OPENING" -> "cell_height_fits_open" [style=dotted];
  "driver_width_drc" [shape=diamond,style=filled,fillcolor=lightgrey];
  "DRC_MIN_WIDTH" -> "driver_width_drc" [style=dotted];
  "M_DEVICE" -> "driver_width_drc" [style=dotted];
  "NF_N_OUT" -> "driver_width_drc" [style=dotted];
  "NF_P_OUT" -> "driver_width_drc" [style=dotted];
  "W_N_OUT" -> "driver_width_drc" [style=dotted];
  "W_P_OUT" -> "driver_width_drc" [style=dotted];
  "esd_up_area" [shape=diamond,style=filled,fillcolor=lightgrey];
  "ESD_AREA_MIN" -> "esd_up_area" [style=dotted];
  "ESD_AREA_UP" -> "esd_up_area" [style=dotted];
  "esd_dn_area" [shape=diamond,style=filled,fillcolor=lightgrey];
  "ESD_AREA_DN" -> "esd_dn_area" [style=dotted];
  "ESD_AREA_MIN" -> "esd_dn_area" [style=dotted];
  "latchup_spacing" [shape=diamond,style=filled,fillcolor=lightgrey];
  "DRC_MIN_SPACING" -> "latchup_spacing" [style=dotted];
  "GUARD_RING_SPACING" -> "latchup_spacing" [style=dotted];
  "latchup_ring_width" [shape=diamond,style=filled,fillcolor=lightgrey];
  "GUARD_RING_RULE_MIN" -> "latchup_ring_width" [style=dotted];
  "GUARD_RING_WIDTH" -> "latchup_ring_width" [style=dotted];
  "rail_em" [shape=diamond,style=filled,fillcolor=lightgrey];
  "IO_CURRENT" -> "rail_em" [style=dotted];
  "METAL_JMAX" -> "rail_em" [style=dotted];
  "RAIL_WIDTH" -> "rail_em" [style=dotted];
  "pad_pitch_drc" [shape=diamond,style=filled,fillcolor=lightgrey];
  "DRC_MIN_SPACING" -> "pad_pitch_drc" [style=dotted];
  "PAD_PITCH" -> "pad_pitch_drc" [style=dotted];
  "dq_lane_identity" [shape=diamond,style=filled,fillcolor=lightgrey];
  "separate_io_rails" [shape=diamond,style=filled,fillcolor=lightgrey];
}
